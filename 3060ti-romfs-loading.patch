-RomFSBuildContext::~RomFSBuildContext() = default;
+RomFSBuildContext::~RomFSBuildContext() {
+    // Break ownership cycles while the vectors still keep every node alive.
+    for (const auto& file : files) {
+        file->parent.reset();
+        file->sibling.reset();
+    }
+    for (const auto& directory : directories) {
+        directory->parent.reset();
+        directory->child.reset();
+        directory->sibling.reset();
+        directory->file.reset();
+    }
+}
 
