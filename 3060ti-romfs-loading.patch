 namespace {
 
+#ifdef _WIN32
+template <typename Callback>
+void IterateWindowsEntries(std::string_view path, bool directories, Callback&& callback) {
+    const auto root = std::filesystem::path{FS::ToU8String(path)};
+    const auto pattern = root / L"*";
+    WIN32_FIND_DATAW data{};
+    HANDLE search = FindFirstFileExW(pattern.c_str(), FindExInfoBasic, &data,
+                                     FindExSearchNameMatch, nullptr, FIND_FIRST_EX_LARGE_FETCH);
+    if (search == INVALID_HANDLE_VALUE && GetLastError() == ERROR_INVALID_PARAMETER) {
+        search = FindFirstFileExW(pattern.c_str(), FindExInfoBasic, &data,
+                                  FindExSearchNameMatch, nullptr, 0);
+    }
+    if (search == INVALID_HANDLE_VALUE) {
+        const auto error = GetLastError();
+        if (error != ERROR_FILE_NOT_FOUND) {
+            LOG_ERROR(Common_Filesystem, "Failed to enumerate directory {}, error={}", path, error);
+        }
+        return;
+    }
+    SCOPE_EXIT { FindClose(search); };
+
+    do {
+        const std::wstring_view name{data.cFileName};
+        if (name == L"." || name == L"..") {
+            continue;
+        }
+        const auto full_path = root / name;
+        u64 size = (static_cast<u64>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+        bool matches = ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0) == directories;
+        // Preserve std::filesystem's target-following behavior for links and junctions.
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {
+            const std::filesystem::directory_entry entry{full_path};
+            matches = directories ? entry.is_directory() : entry.is_regular_file();
+            if (matches && !directories) {
+                size = entry.file_size();
+            }
+        } else if (data.dwFileAttributes & FILE_ATTRIBUTE_DEVICE) {
+            matches = false;
+        }
+        if (matches) {
+            callback(FS::PathToUTF8String(full_path), size);
+        }
+    } while (FindNextFileW(search, &data));
+
+    const auto error = GetLastError();
+    if (error != ERROR_NO_MORE_FILES) {
+        LOG_ERROR(Common_Filesystem, "Directory enumeration failed for {}, error={}", path, error);
+    }
+}
+#endif
